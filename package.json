{
  "name": "radical-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Portable offline arbitrary-precision complex and symbolic calculator",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/notices.mjs && tsc --noEmit && vite build && node scripts/package.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "nerdamer": "1.1.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
